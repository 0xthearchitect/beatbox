{
  "name": "beatbox-web",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "The BeatBox interface, embedded in the BeatBox window (shell/).",
  "scripts": {
    "build": "npm run locales:check && tsc --noEmit && vite build",
    "typecheck": "npm run locales:check && tsc --noEmit",
    "test": "npm run locales:check && node --test tests/",
    "locales:generate": "node scripts/locales.mjs --write",
    "locales:check": "node scripts/locales.mjs",
    "locales:report": "node scripts/locales.mjs --report"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@novnc/novnc": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "ogl": "^1.0.11",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "rolldown": "1.2.8"
  }
}
