{
  "profiles": {
    "linux-kvm": {
      "kvm": true,
      "whpx": false,
      "cpu": null,
      "tcp": false
    },
    "linux-tcg": {
      "kvm": false,
      "whpx": false,
      "cpu": null,
      "tcp": false
    },
    "windows-whpx": {
      "kvm": false,
      "whpx": true,
      "cpu": null,
      "tcp": true
    },
    "windows-tcg-chosen-cpu": {
      "kvm": false,
      "whpx": false,
      "cpu": "Skylake-Client-v4",
      "tcp": true
    }
  },
  "commands": [
    {
      "profile": "linux-kvm",
      "case": "disposable-headless",
      "spec": {
        "name": "plain",
        "image": "{DIR}/disk.qcow2",
        "headless": true
      },
      "argv": [
        "qemu-system-x86_64",
        "-name",
        "plain",
        "-uuid",
        "{UUID}",
        "-m",
        "2048",
        "-smp",
        "2",
        "-snapshot",
        "-device",
        "ahci,id=ahci0",
        "-drive",
        "file={DIR}/disk.qcow2,if=none,id=sysdisk,discard=unmap,detect-zeroes=unmap",
        "-device",
        "ide-hd,bus=ahci0.0,drive=sysdisk,rotation_rate=1",
        "-accel",
        "kvm",
        "-cpu",
        "host,hv-relaxed=on,hv-vapic=on,hv-spinlocks=0x1fff,hv-vpindex=on,hv-runtime=on,hv-time=on,hv-synic=on,hv-stimer=on,hv-frequencies=on",
        "-device",
        "virtio-balloon-pci,free-page-reporting=on,deflate-on-oom=on",
        "-nic",
        "none",
        "-display",
        "none"
      ]
    },
    {
      "profile": "linux-kvm",
      "case": "host-sandbox-windowed",
      "spec": {
        "name": "win10",
        "image": "{DIR}/room/disk.qcow2",
        "memory_mb": 2048,
        "cpus": 2,
        "headless": false,
        "disposable": false,
        "monitor_socket": "{DIR}/room/monitor.sock",
        "agent_socket": "{DIR}/room/agent.sock",
        "log_path": "{DIR}/room/qemu.log"
      },
      "argv": [
        "qemu-system-x86_64",
        "-name",
        "win10",
        "-uuid",
        "{UUID}",
        "-m",
        "2048",
        "-smp",
        "2",
        "-device",
        "ahci,id=ahci0",
        "-drive",
        "file={DIR}/room/disk.qcow2,if=none,id=sysdisk,discard=unmap,detect-zeroes=unmap",
        "-device",
        "ide-hd,bus=ahci0.0,drive=sysdisk,rotation_rate=1",
        "-accel",
        "kvm",
        "-cpu",
        "host,hv-relaxed=on,hv-vapic=on,hv-spinlocks=0x1fff,hv-vpindex=on,hv-runtime=on,hv-time=on,hv-synic=on,hv-stimer=on,hv-frequencies=on",
        "-device",
        "virtio-balloon-pci,free-page-reporting=on,deflate-on-oom=on",
        "-nic",
        "none",
        "-qmp",
        "unix:{DIR}/room/monitor.sock,server=on,wait=off",
        "-chardev",
        "socket,path={DIR}/room/agent.sock,server=on,wait=off,id=qga0",
        "-device",
        "virtio-serial",
        "-device",
        "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0",
        "-device",
        "qemu-xhci,id=usb0",
        "-device",
        "usb-tablet,bus=usb0.0"
      ]
    },
    {
      "profile": "linux-kvm",
      "case": "isolated-hostile-capture-ports-instrument",
      "spec": {
        "name": "triage",
        "image": "{DIR}/room/disk.qcow2",
        "memory_mb": 3072,
        "cpus": 4,
        "network": "isolated",
        "hostile": true,
        "headless": true,
        "disposable": false,
        "capture_path": "{DIR}/room/capture.pcap",
        "forwarded_ports": [
          [
            8080,
            80
          ],
          [
            2222,
            22
          ]
        ],
        "instrument": true,
        "monitor_socket": "{DIR}/room/monitor.sock"
      },
      "argv": [
        "qemu-system-x86_64",
        "-name",
        "triage",
        "-uuid",
        "{UUID}",
        "-m",
        "3072",
        "-smp",
        "4",
        "-device",
        "ahci,id=ahci0",
        "-drive",
        "file={DIR}/room/disk.qcow2,if=none,id=sysdisk,discard=unmap,detect-zeroes=unmap",
        "-device",
        "ide-hd,bus=ahci0.0,drive=sysdisk,rotation_rate=1",
        "-accel",
        "kvm",
        "-cpu",
        "host,hv-relaxed=on,hv-vapic=on,hv-spinlocks=0x1fff,hv-vpindex=on,hv-runtime=on,hv-time=on,hv-synic=on,hv-stimer=on,hv-frequencies=on",
        "-device",
        "virtio-balloon-pci,free-page-reporting=on,deflate-on-oom=on",
        "-netdev",
        "user,id=net0,restrict=on,hostfwd=tcp::8080-:80,hostfwd=tcp::2222-:22,hostfwd=tcp::27042-:27042",
        "-device",
        "e1000,netdev=net0",
        "-object",
        "filter-dump,id=dump0,netdev=net0,maxlen=512,file={DIR}/room/capture.pcap",
        "-qmp",
        "unix:{DIR}/room/monitor.sock,server=on,wait=off",
        "-display",
        "none"
